  "repository": {
    "type": "git",
    "url": "git+https://github.com/WhiteBr1ck/koishi-plugin-imgsearch-coser.git"
  },
  "homepage": "https://github.com/WhiteBr1ck/koishi-plugin-imgsearch-coser#readme",
  "bugs": {
    "url": "https://github.com/WhiteBr1ck/koishi-plugin-imgsearch-coser/issues"
  },
  "keywords": [
    "koishi",
