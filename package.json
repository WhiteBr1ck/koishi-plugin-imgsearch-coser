    "coser",
    "google-lens",
    "serpapi",
    "reverse-image-search",
    "image-search"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "peerDependencies": {
    "koishi": "^4.18.9",
    "@koishijs/plugin-console": "^5.30.0"
  },
