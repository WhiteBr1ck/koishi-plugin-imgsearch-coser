    "@types/node": "^22.7.5"
  },
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit --incremental false -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "build:client": "node -e \"import('@koishijs/client/lib').then(({ build }) => build(process.cwd()))\""
